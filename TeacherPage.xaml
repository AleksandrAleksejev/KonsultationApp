<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KonsultationApp.TeacherPage"
             Title="Учитель">

    <StackLayout Padding="20" Spacing="15">
        <Label Text="Добро пожаловать, учитель!" FontSize="Title" />

        <Button Text="Создать консультацию" Clicked="OnAddConsultationClicked" />
        <Button Text="Просмотреть консультации" Clicked="OnViewConsultationsClicked" />
        <Button Text="Просмотреть регистрации" Clicked="OnViewRegistrationsClicked" />
        <Button Text="Отправить SMS" Clicked="OnSendSMSClicked" />
        <Button Text="Выйти" Clicked="OnLogoutClicked" />
    </StackLayout>
</ContentPage>