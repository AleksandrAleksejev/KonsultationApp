<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KonsultationApp.LoginPage">

    <StackLayout Padding="20" Spacing="15">
        <Entry Placeholder="Имя" x:Name="UsernameEntry" />
        <Entry Placeholder="Пароль" x:Name="PasswordEntry" IsPassword="True" />

        <Button Text="Войти" Clicked="OnLoginClicked" />
        <Button Text="Назад" Clicked="OnBackClicked" />
    </StackLayout>
</ContentPage>